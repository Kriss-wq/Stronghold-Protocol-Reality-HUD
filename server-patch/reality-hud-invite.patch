+/**
+ * The GET /api/players body (Reality HUD overlay): the sessions connected right now — who may be invited from the
+ * HUD (server/lobby.js invite). Names and playerIds are already visible in a room to its members; the room codes
+ * never leave this function (they are the join secret — only the invited session ever receives one, via
+ * S2C room.invited), and neither do tokens nor addresses.
+ * @param {{ registry: import('../net.js').SessionRegistry, lobby: import('../lobby.js').Lobby }} deps
+ */
+export function playersReport({ registry, lobby }) {
+  const players = [];
+  for (const s of registry.byPlayerId.values()) {
+    if (!s.connected) continue;
+    const room = s.roomCode ? lobby.getRoom(s.roomCode) : null;
+    players.push({ id: s.playerId, name: s.name, inRoom: !!room, inMatch: !!(room && room.match) });
+  }
+  return { ok: true, players };
+}
+
